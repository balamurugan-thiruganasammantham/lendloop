# ---------------------------------------------------------------------------
# LendLoop — Next.js environment (copy to .env.local; never commit real values)
# Convex backend variables are NOT set here: use `npx convex env set` (see README).
# ---------------------------------------------------------------------------

# Convex (written automatically by `npx convex dev`)
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Clerk (https://dashboard.clerk.com → API keys, or `npx clerk@latest init`)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/explore
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# Mapbox (recommended). With a token the map uses Mapbox GL + the Mapbox Standard
# style (faded theme, globe view). Create a public token at
# https://account.mapbox.com/access-tokens and restrict it to your URLs.
# Without a token LendLoop falls back to MapLibre + OpenFreeMap (no account needed).
NEXT_PUBLIC_MAPBOX_TOKEN=
# Optional: your own Mapbox Studio style instead of Standard (mapbox://styles/<user>/<id>).
NEXT_PUBLIC_MAPBOX_STYLE_URL=

# Fallback basemap (used only without a Mapbox token). Default: the built-in LendLoop MapLibre style on
# OpenFreeMap vector tiles (OpenStreetMap data, no API key). Either replace the
# whole style, e.g. https://api.maptiler.com/maps/dataviz-light/style.json?key=KEY
NEXT_PUBLIC_MAP_STYLE_URL=
# …or keep the LendLoop style and point it at other OpenMapTiles-schema sources.
NEXT_PUBLIC_MAP_TILES_URL=
NEXT_PUBLIC_MAP_GLYPHS_URL=

# Geocoding proxy (optional). Default: Nominatim. Its usage policy requires an
# identifying User-Agent with contact details.
GEOCODER_URL=
GEOCODER_USER_AGENT="LendLoop/1.0 (you@example.com)"

# Routing proxy (optional). Defaults: OSRM demo servers (not for production).
ROUTING_WALK_URL=
ROUTING_DRIVE_URL=

# End-to-end tests (optional): path to a local Chrome if Playwright browsers aren't installed.
PLAYWRIGHT_CHROME_PATH=
