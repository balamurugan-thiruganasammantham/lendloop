# LendLoop n8n configuration. Copy to n8n/.env (git-ignored) and fill in.
# docker-compose.yml loads this file into the n8n container.

# Encrypts credentials stored in n8n's database. Generate once and keep it:
#   openssl rand -hex 32
# Changing it later makes existing n8n credentials unreadable.
N8N_ENCRYPTION_KEY=replace-with-openssl-rand-hex-32

# Verifies webhooks Convex sends to n8n (Workflow A).
# MUST equal the Convex env var N8N_WEBHOOK_SECRET.
#   openssl rand -hex 32
#   npx convex env set N8N_WEBHOOK_SECRET <same value>
LENDLOOP_N8N_WEBHOOK_SECRET=replace-with-64-hex-chars

# Signs requests n8n makes to Convex /automation/* endpoints.
# MUST equal the Convex env var AUTOMATION_INBOUND_SECRET:
#   npx convex env get AUTOMATION_INBOUND_SECRET
LENDLOOP_AUTOMATION_SECRET=replace-with-64-hex-chars

# Convex HTTP actions base URL as seen from inside the n8n container.
# Local `npx convex dev` deployment: http://host.docker.internal:3211
# Cloud deployment: https://<deployment>.convex.site
LENDLOOP_CONVEX_SITE_URL=http://host.docker.internal:3211

# mock = no email is sent, deliveries are reported as MOCKED (default).
# smtp = send via the n8n SMTP credential named "LendLoop SMTP".
LENDLOOP_EMAIL_MODE=mock

# From address used in smtp mode.
LENDLOOP_EMAIL_FROM=LendLoop <no-reply@lendloop.local>
